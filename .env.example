# Centinela — variables de entorno
#
#   cp .env.example .env
#
# Todo es opcional para correr en local: sin Supabase, `src/db.js` guarda en
# `data/*.json` y la suite pasa igual. Se vuelve obligatorio al desplegar,
# porque el filesystem de Vercel es efímero y un suscriptor guardado en una
# petición puede no existir en la siguiente.

# ---------------------------------------------------------------- Supabase
# Ambas juntas o ninguna: `db.js` solo usa Supabase si están las dos.
# Se sacan de Project Settings → API.

# URL del proyecto, sin barra final.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# service_role, NO la anon.
#
# Salta RLS a propósito: el bot escribe suscriptores y recursos desde el
# servidor. Por lo mismo nunca puede llegar al navegador ni al repo.
SUPABASE_SERVICE_KEY=

# Solo para aplicar el esquema a mano, el código no la lee:
#   psql "$SUPABASE_DB_URL" -f db/schema.sql
# Project Settings → Database → Connection string (URI).
SUPABASE_DB_URL=

# ---------------------------------------------------------------- WhatsApp
# El envío va por el CLI de Kapso, que trae su propia sesión: no hay token
# que poner acá. Se autentica una vez con:
#
#   kapso login
#   kapso projects use <id del proyecto melo>
#
# El número emisor está fijo en src/whatsapp.js (PHONE_NUMBER_ID).

# Excepción: bajar una nota de voz sí necesita token propio. El CLI de Kapso
# no expone media, así que `src/transcribir.js` va directo a Graph. Es el
# token de la app de Meta con permiso whatsapp_business_messaging.
# Sin esto, los audios se contestan con un "escríbeme la pregunta".
WHATSAPP_TOKEN=

# -------------------------------------------------------------- ElevenLabs
# Transcribe las notas de voz entrantes (modelo scribe_v1, español fijo).
# Sin esta clave el bot no se rompe: pide la pregunta por escrito.
# Se saca de elevenlabs.io → Profile → API Keys.
ELEVENLABS_API_KEY=

# -------------------------------------------------------------- OpenRouter
# Clasifica las preguntas abiertas que las palabras clave no reconocen
# ("junté ropa usada, ¿le sirve a alguien?"). El modelo solo elige una
# categoría de una lista cerrada: nunca redacta la respuesta ni nombra un
# lugar. Sin esta clave el bot no se rompe, solo vuelve a contestar el detalle
# del último sismo cuando no entiende.
# Se saca de openrouter.ai → Keys.
OPENROUTER_API_KEY=

# Opcional. Por defecto openai/gpt-4o-mini: es clasificar una frase en 14
# opciones, no hace falta más.
OPENROUTER_MODEL=
